PORT=3000
NODE_ENV=production

# JWT secret — change in production!
JWT_SECRET=change-me-in-production

# PostgreSQL connection string
DATABASE_URL=postgresql://mapcall:mapcallpass@postgres:5432/mapcall

# Frontend URL (where the client app is served from)
# In production, set to your domain. Electron points here for OAuth redirects.
CLIENT_URL=http://localhost:5173

# ── Yandex OAuth ──────────────────────────────────
# Register at https://oauth.yandex.ru/client/new
# Callback URL: http://your-server/auth/yandex/callback
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=http://localhost:3000/auth/yandex/callback

# ── Google OAuth ──────────────────────────────────
# Register at https://console.cloud.google.com → APIs & Services → Credentials
# Callback URL: http://your-server/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
